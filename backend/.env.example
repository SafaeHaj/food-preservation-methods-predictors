# Copy to backend/.env (or export these in your shell) before starting the
# FastAPI backend. Only LLM_PROVIDER, OLLAMA_BASE_URL, and OLLAMA_MODEL are
# needed for the default local setup; the GROQ_* vars are only read when
# LLM_PROVIDER=groq.

# Two working providers, switch with LLM_PROVIDER (no other code changes needed):
#
# ollama (fully local/private, no API key, but slow on CPU -- ~10-90s/turn with
#   the default qwen3:8b; smaller qwen3 variants were tested and rejected
#   because they don't reliably use structured tool calls, which breaks the
#   "never invent numbers" guarantee)
# groq  (cloud-hosted, ~1-3s/turn, needs a free API key from console.groq.com/keys;
#   only the chat text is sent to Groq -- your data/models/predictions stay local)

LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
