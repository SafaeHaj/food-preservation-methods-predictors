# Copy to pipeline/.env — docker compose reads it for ${VAR} interpolation.
#
# Every setting the services read is listed here. Anything omitted falls back to the
# default declared on the corresponding class in shared/shared/config/, with one
# exception: SECRET_KEY has no default and must be provided.

# ── Postgres (shared by all services) ─────────────────────────────────────────
# REQUIRED. No shipped default — pick your own values here.
POSTGRES_USER=food
# NOTE: this is baked into the pgdata volume the first time Postgres initialises. Changing
# it later does NOT change the real password -- you also need `docker compose down -v`
# (destroys the data) or an `ALTER USER` inside the running container.
POSTGRES_PASSWORD=food
POSTGRES_DB=food_research
# Host port for the database, bound to 127.0.0.1 only. Set to a free port if 5432 is taken.
POSTGRES_PORT=5432

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED. Services refuse to start without it. It signs both JWTs and asset URLs, so
# every service must share the same value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shared secret the gateway sends to internal services as X-Internal-Secret; extraction,
# processing and prediction reject anything without it. Empty disables the check and those
# services then trust the gateway's X-User-Id header from ANY caller. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── CORS / frontend ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
VITE_API_URL=http://localhost:8000

# ── Gateway ───────────────────────────────────────────────────────────────────
# How long a signed asset URL (figure PNG, page image, chart CSV) stays valid.
ASSET_URL_TTL_SECONDS=900
# Job progress stream tuning.
JOB_STREAM_POLL_SECONDS=1.0
JOB_STREAM_KEEPALIVE_SECONDS=15
JOB_STREAM_MAX_SECONDS=3600
PROXY_TIMEOUT_SECONDS=600

# ── The extraction → processing hand-off ──────────────────────────────────────
# Where extraction stages a paper's gated package and processing reads it back. Both
# services mount the same uploads volume, so they must agree on this one path.
SILVER_CACHE_DIR=silver_cache

# ── Extraction service (EXTRACTION_ prefix) ───────────────────────────────────
# Extraction reads documents: Docling, PP-Chart2Table and the deterministic schema gate.
# It has no LLM and no vocabulary — both live on the processing service now.
EXTRACTION_MAX_UPLOAD_SIZE_MB=50
EXTRACTION_MAX_PAPERS_PER_UPLOAD=10

# Bump to invalidate every cached Docling parse after a pipeline change.
EXTRACTION_DOCLING_CACHE_VERSION=3

# 0 admits every figure that passes the geometry probe without reading its chart. That
# changes what the data means, not only how long extraction takes.
EXTRACTION_REQUIRE_FIGURE_DATA=1
EXTRACTION_TABLE_STRUCTURE=1
EXTRACTION_TABLE_STRUCTURE_MODE=fast
# Resolution for exported figures and page previews, relative to the page.
EXTRACTION_IMAGES_SCALE=1.5
EXTRACTION_CHART_BATCH_SIZE=8
EXTRACTION_CHART_MAX_PIXELS=1024
EXTRACTION_FIGURE_CONTEXT_CHARS=1200

# Which assets are offered to the gate when the user has not curated the selection by hand.
EXTRACTION_AUTO_SELECT_MIN_SCORE=3.0
EXTRACTION_AUTO_SELECT_MIN_TABLE_SCORE=1.0

EXTRACTION_DEFAULT_ASSET_PAGE_SIZE=100
EXTRACTION_MAX_ASSET_PAGE_SIZE=500

# ── Processing service (PROCESSING_ prefix) ───────────────────────────────────
#
# SWITCHING TO A PAID API is two lines: set PROCESSING_LLM_PROVIDER and its key. Model and
# base URL default per provider, so nothing else has to change.
#
#   # Google AI Studio — key from aistudio.google.com/apikey
#   PROCESSING_LLM_PROVIDER=gemini
#   PROCESSING_GEMINI_API_KEY=…
#
# Put comments on their own line. A .env value runs to the end of the line, so
# `PROCESSING_LLM_PROVIDER=gemini  # Google AI Studio` sets the provider to the whole
# string including the comment, and the service fails with "Unknown LLM provider".
#
# Gemini model note: the 2.5 family still appears in `GET /v1beta/models` but returns 404
# "no longer available to new users" for keys created recently. The default is a gemini-3
# model for that reason; a wrong id is reported by GET /health with the usable list.
#
# The model is asked for two prose fields (an arm's treatment and sample weight), for the
# treatment and application-method classifications, and for hints about tables the gate
# could not key. Every number is read by the pipeline itself, so a provider change moves
# those fields and nothing else.
PROCESSING_LLM_PROVIDER=ollama
# Blank means the provider's own default (see processing/app/services/llm/registry.py).
PROCESSING_LLM_MODEL=
PROCESSING_LLM_BASE_URL=

# 0.0 throughout: a sampled answer to "what does this methods section say" is a different
# answer, not a better one.
PROCESSING_LLM_TEMPERATURE=0.0
# 0 = the provider's default. Setting this below a reasoning model's natural trace length
# ends the call before any JSON is emitted.
PROCESSING_LLM_MAX_OUTPUT_TOKENS=0
PROCESSING_LLM_TIMEOUT_SECONDS=600
PROCESSING_LLM_RETRIES=3
PROCESSING_LLM_RETRY_BACKOFF=2.0
# Constrain decoding with a JSON Schema. Off by default: on some Ollama builds the grammar
# is applied to the reasoning channel too and mangles the answer. GET /health reports
# whether this deployment is safe ("schema_safe").
# On a hosted provider there is no such problem -- set this to 1 with gemini, openai or
# anthropic. It is what makes the Gold call's closed vocabularies binding on generation
# rather than merely requested in the prompt.
PROCESSING_LLM_JSON_SCHEMA=0
# true | false | low | medium | high. Drives Ollama's `think`, OpenAI's `reasoning_effort`
# and Gemini's thinking budget. MUST be false for a model with no reasoning channel
# (llama3.2:3b) — some Ollama builds reject the request outright.
PROCESSING_LLM_REASONING=true
# Replies are cached on the prompts, so a re-queued paper does not re-pay for its calls.
PROCESSING_LLM_CACHE_ENABLED=1
PROCESSING_LLM_MAX_PROMPT_CHARS=24000

# API keys. Only the selected provider's is read; a provider chosen without its key fails
# at startup naming the variable, not mid-run as a 401.
PROCESSING_OPENAI_API_KEY=
PROCESSING_ANTHROPIC_API_KEY=
PROCESSING_GEMINI_API_KEY=
PROCESSING_GROQ_API_KEY=

# Local Ollama. llama3.2:3b is pulled into the ollama container on first start; the tag here
# is what `ollama-pull` downloads. On a GPU host, deepseek-r1:14b is markedly better.
PROCESSING_OLLAMA_BASE_URL=http://ollama:11434
PROCESSING_OLLAMA_MODEL=llama3.2:3b
# Context window, a server-side setting here rather than a property of the model. Lower it
# until `ollama ps` reports 100% GPU: anything less means layers are on the CPU.
PROCESSING_OLLAMA_NUM_CTX=16384
PROCESSING_OLLAMA_NUM_PREDICT=0
# -1 keeps the weights resident between papers, so a run does not reload them each time.
PROCESSING_OLLAMA_KEEP_ALIVE=-1

# Blank uses the vocabulary shipped at processing/config/vocabulary.yaml. Point it at a
# bind-mounted file to run a project-specific vocabulary without rebuilding the image.
PROCESSING_VOCABULARY_PATH=
PROCESSING_SECTION_SCAN_CHARS=2000
# 0 makes treatment and application-method classification keyword-only; unmatched values
# fall to their "Other" sink rather than being arbitrated by the model.
PROCESSING_CLASSIFY_WITH_LLM=1

PROCESSING_PREDICTION_SERVICE_URL=http://prediction:8100
PROCESSING_PREDICTION_TIMEOUT_SECONDS=600

# ── Prediction service ────────────────────────────────────────────────────────
SURVIVAL_ARTIFACT_DIR=/artifacts
