# Copy to .env and fill in values. NEVER commit .env to version control.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
DATABASE_URL=sqlite:///./food_research.db
# PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/food_research

# ============================================================
# AI Provider — set AI_PROVIDER to ONE of: vertexai, google_ai, openai, anthropic
# ============================================================
AI_PROVIDER=vertexai

# OPTION A — Vertex AI (ADC)
#   Requires: gcloud auth application-default login
#   AND: ziadfri318@gmail.com must have "Vertex AI User" IAM role on the project
VERTEX_PROJECT=joinagent
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

# OPTION B — Google AI Studio (easiest, free key, no IAM needed)
#   Get key at: aistudio.google.com -> Get API key
#   Set AI_PROVIDER=google_ai and fill in GOOGLE_API_KEY
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# OPTION C — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPTION D — Anthropic
ANTHROPIC_API_KEY=

AI_MAX_TOKENS=4096

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_PAPERS_PER_UPLOAD=10
UPLOAD_DIR=uploads
