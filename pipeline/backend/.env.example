# Copy this file to .env and fill in values. NEVER commit .env to version control.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# SQLite (default for local dev — no setup required)
DATABASE_URL=sqlite:///./food_research.db
# PostgreSQL (production) — uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/food_research

# --- AI Extraction (never expose to frontend) ---
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_PAPERS_PER_UPLOAD=10
UPLOAD_DIR=uploads
