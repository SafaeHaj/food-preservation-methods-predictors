frontend/node_modules
frontend/dist
frontend/.vite
**/__pycache__
**/.pytest_cache
**/*.pyc

# service-local runtime state
prediction/data
prediction/results
prediction/misc
prediction/tests
extraction/uploads
processing/exports

*.log
.env
